# this is just for sample purposes, how my project's backend .env looks like 

# Google AI Studio / Gemini Developer API
GEMINI_API_KEY=_gemini_api_key_ 
# Models are attempted from left to right when a model returns a quota/rate-limit error.
GEMINI_MODEL_CHAIN=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash